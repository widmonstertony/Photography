{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonytan.me/schemas/photography-gallery.json",
  "title": "Tony Tan photography gallery",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "publishedAt", "title", "alt", "original", "preview", "width", "height"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$" },
          "publishedAt": { "type": "string", "format": "date-time" },
          "capturedAt": { "type": ["string", "null"] },
          "title": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": { "en": { "type": "string", "minLength": 1, "maxLength": 120 }, "zh": { "type": "string", "minLength": 1, "maxLength": 120 } },
            "additionalProperties": false
          },
          "alt": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": { "en": { "type": "string", "minLength": 1, "maxLength": 180 }, "zh": { "type": "string", "minLength": 1, "maxLength": 180 } },
            "additionalProperties": false
          },
          "location": { "$ref": "#/$defs/optionalLocalizedText" },
          "vehicle": { "$ref": "#/$defs/optionalLocalizedText" },
          "camera": { "type": "string", "maxLength": 100 },
          "lens": { "type": "string", "maxLength": 100 },
          "width": { "type": "integer", "minimum": 1, "maximum": 30000 },
          "height": { "type": "integer", "minimum": 1, "maximum": 30000 },
          "original": { "type": "string", "format": "uri", "pattern": "^https://raw\\.githubusercontent\\.com/widmonstertony/Photography/media/originals/[0-9]{4}/[a-z0-9-]+\\.(jpg|png|webp)$" },
          "preview": { "type": "string", "format": "uri", "pattern": "^https://raw\\.githubusercontent\\.com/widmonstertony/Photography/media/previews/[0-9]{4}/[a-z0-9-]+\\.webp$" },
          "featured": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "optionalLocalizedText": {
      "type": "object",
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "maxLength": 100 },
        "zh": { "type": "string", "maxLength": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
